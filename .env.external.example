# binjari 외부용 웹서버(web_external.py) 게이트 설정 — 양식.
# 새 머신 셋업: 이 파일을 .env.external 로 복사 후 <...> 자리에 실값 입력.
# Azure 앱 자격증명은 별도 파일 .env.azure (azure_env_export 스킬로 .env.ktx 에서 추출).

# 외부 공개 주소 (Caddy 가 이 도메인 → 127.0.0.1:8002 로 프록시)
EXT_BASE_URL=https://<외부 도메인>

# 세션 쿠키 서명 키 — python -c "import secrets; print(secrets.token_hex(32))" 로 생성
EXT_SESSION_SECRET=<64자리 hex 랜덤 문자열>

# 로그인을 허용할 Microsoft 계정 이메일 (콤마 구분, 소문자) — 조회 화면만 사용 가능
EXT_ALLOWED_EMAILS=<email1@example.com>,<email2@example.com>

# 관리자 계정 (콤마 구분) — 로컬 UI 전체(예매설정·환경설정·감시 제어)를 프록시로 사용.
# 허용 목록에 자동 포함되므로 EXT_ALLOWED_EMAILS 에 중복 기재 불필요.
EXT_ADMIN_EMAILS=<owner@example.com>

# 세션 유지 일수
EXT_SESSION_DAYS=7
